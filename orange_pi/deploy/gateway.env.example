# Copy to /etc/rover-one/gateway.env, set mode 600, and edit for the UART
# that is actually enabled in the Orange Pi device tree.

GATEWAY_APP=app:app
ROVER_SERIAL_PORT=/dev/ttyS5
ROVER_BAUD=115200
ROVER_WATCHDOG_MS=200
ROVER_ALLOWED_ORIGINS=http://10.42.0.1,http://rover-one.local
ROVER_DRY_RUN=1

# ROVER_WEB_ROOT is intentionally omitted. Nginx serves the prebuilt local
# static site directly, while the gateway only owns /ws and /health.
